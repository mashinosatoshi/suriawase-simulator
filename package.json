{
  "name": "suriawase-simulator",
  "version": "2.0.0",
  "description": "AI と対話して、相手の本音を聞き出し、落としどころを探す対話ゲーム",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mashinosatoshi/suriawase-simulator.git"
  },
  "bugs": {
    "url": "https://github.com/mashinosatoshi/suriawase-simulator/issues"
  },
  "homepage": "https://github.com/mashinosatoshi/suriawase-simulator#readme",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build:client": "esbuild src/client.ts --bundle --minify --sourcemap --outfile=public/client.js --target=es2022",
    "build:serve": "esbuild src/serve.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/serve.mjs",
    "serve": "npm run build:client && npm run build:serve && node dist/serve.mjs",
    "start": "npm run build:client && tsx src/server.ts",
    "mcp": "npm run build:client --silent && tsx src/server.ts --mcp",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.32.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "openai": "^7.47.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
